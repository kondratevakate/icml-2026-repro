```
python3 -m venv venv && ./venv/bin/pip install numpy scipy sympy
./venv/bin/python verify_claim2.py   # ~9 min  (exhaustive)
./venv/bin/python verify_claim6.py   # ~10 s
./venv/bin/python verify_claim1.py   # ~4 min
./venv/bin/python verify_claim3.py   # ~2 min
./venv/bin/python verify_claim4.py   # ~1 min
./venv/bin/python verify_claim5.py   # ~3 min
./venv/bin/python bound_check.py     # post-hoc R/sqrt(KT) table
```
